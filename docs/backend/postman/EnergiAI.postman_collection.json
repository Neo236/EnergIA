{
	"info": {
		"_postman_id": "energiai-collection-v1",
		"name": "EnergiAI — Analisis Energetico",
		"description": "Coleccion Postman definitiva para la API REST de EnergiAI.\n\nIncluye: health checks, happy path (3 perfiles), validaciones 400, 404, 502, 503, timeout, y validacion directa contra el ML service.\n\nCada request incluye aserciones automaticas de estructura y rangos.",
