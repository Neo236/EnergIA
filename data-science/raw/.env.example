# EnergIA MVP - Environment Variables

# ===========================================
# Storage backend (local | oci)
# ===========================================
# local: filesystem (default para dev/CI/tests)
# oci:   OCI Object Storage bucket via SDK oficial (requiere credenciales OCI)
# par:   OCI Object Storage via Pre-Authenticated Request URL (sin SDK, sin credenciales)
STORAGE_BACKEND=local

# ===========================================
# PAR - Pre-Authenticated Request (solo si STORAGE_BACKEND=par)
# ===========================================
# URL base del PAR de OCI Object Storage. Incluye el token embebido.
# Termina en /o/ (path de objetos del bucket). Tratar como secreto.
# Ejemplo:
# OCI_PAR_URL=https://objectstorage.sa-santiago-1.oraclecloud.com/p/<token>/b/<bucket>/o
OCI_PAR_URL=

# Root usado por LocalStorage (default: cwd)
STORAGE_LOCAL_ROOT=.

# ===========================================
# OCI Object Storage (solo si STORAGE_BACKEND=oci)
# ===========================================
# Namespace del Object Storage (ej. 'sergiovillenavergara')
OCI_NAMESPACE=
# Nombre del bucket (ej. 'g9-energy-test-bucket')
OCI_BUCKET=
# Región del bucket (ej. 'sa-santiago-1')
OCI_REGION=sa-santiago-1

# ===========================================
# OCI Auth (elegir uno)
# ===========================================

# Opción A: instance principal (en VM OCI Compute, sin credenciales)
# OCI_INSTANCE_PRINCIPAL=true

# Opción B: archivo de config (~/.oci/config)
# OCI_CONFIG_FILE=/home/opc/.oci/config

# Opción C: API key via env vars
# OCI_USER_OCID=ocid1.user.oc1..xxx
# OCI_TENANCY_OCID=ocid1.tenancy.oc1..xxx
# OCI_FINGERPRINT=xx:xx:xx:xx
# OCI_PRIVATE_KEY_PATH=/path/to/key.pem
# OCI_PRIVATE_KEY_CONTENT="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# ===========================================
# Modelo / training
# ===========================================
NUM_CLIENTES=2000
RANDOM_SEED=42
OUTPUT_JSON_PATH=data/database_beta.json
OUTPUT_MODEL_PATH=data/modelo_eficiencia_v1.joblib
OUTPUT_METRICAS_PATH=data/metricas_v1.joblib
UMBRAL_EFICIENTE=80
UMBRAL_MODERADO=50