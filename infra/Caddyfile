# Espejo local del proxy de la VM (infra/Caddyfile).
#
# Existe por una sola razón: en la VM, el front y la API comparten origen
# porque Caddy los une bajo un mismo dominio. En una máquina de desarrollo
# NO alcanza con que "todo corra en local": http://localhost:3000 y
# http://localhost:8080 son ORÍGENES DISTINTOS para el navegador — el
# puerto forma parte del origen. Sin este proxy, el fetch a /api/v1/...
# desde el front daría 404, y apuntarlo a localhost:8080 daría error de
# CORS.
#
# La alternativa sería habilitar CORS en Spring solo para desarrollo, pero
# eso agrega configuración que existe únicamente en dev, que es fácil que
# se filtre a producción, y que hace que "funciona en mi máquina" deje de
# significar algo. Con este proxy, local se comporta igual que la VM.
#
# Se levanta con:  docker compose --profile local up -d
# Y se entra por:  http://localhost:8088

:8088 {
	handle /api/* {
		reverse_proxy backend:8080
	}

	handle /swagger-ui/* {
		reverse_proxy backend:8080
	}

	handle /v3/api-docs* {
		reverse_proxy backend:8080
	}

	handle /actuator/* {
		reverse_proxy backend:8080
	}

	handle {
		reverse_proxy frontend:8080
	}
}
