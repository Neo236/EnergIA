# =============================================================================
# .gitignore — G9 LATAM TEAM 09 | Hackathon ONE | Alura + Oracle
# Cubre: Java/Maven · Python/Data Science · IDEs · OS · Seguridad/OCI
# =============================================================================


# ──────────────────────────────────────────────────────────────────────────────
# JAVA / MAVEN / SPRING BOOT
# ──────────────────────────────────────────────────────────────────────────────
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

*.class
*.jar
*.war
*.ear
*.nar

# Maven wrapper binaries
.mvn/wrapper/maven-wrapper.jar
.mvn/wrapper/MavenWrapperDownloader.java

# Spring Boot devtools
.spring-boot-devtools.properties

# Logs generados por Spring
*.log
logs/
log/


# ──────────────────────────────────────────────────────────────────────────────
# PYTHON / DATA SCIENCE / MACHINE LEARNING
# ──────────────────────────────────────────────────────────────────────────────

# Bytecode
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd

# Entornos virtuales
.venv/
venv/
env/
ENV/
.env/
.python-version

# Distribución / Packaging
dist/
build/
*.egg-info/
*.egg
MANIFEST

# Jupyter Notebooks
.ipynb_checkpoints/
*.ipynb_checkpoints
profile_default/
ipython_config.py

# Modelos serializados y datasets
*.pkl
*.pickle
*.joblib
*.h5
*.hdf5
*.model
*.pt
*.pth
*.onnx
*.sav

# Datasets locales (subir solo a OCI Object Storage)
data/raw/
data/processed/
data-science/raw/data/
# Simulacion local del bucket OCI (STORAGE_BACKEND=local): se regenera con
# `make pipeline` o `python -m interfaces.cli.train`. NO commitear.
data-science/raw/latest/
# Historico de rotacion del bucket: snapshots previos cuando cambia el
# code_version del training pipeline. Se regenera automaticamente. NO commitear.
data-science/raw/archive/
*.csv
*.parquet
*.json.gz
*.xlsx
*.xls
# Sidecars SHA256 de artefactos locales (sin los binarios no tienen sentido)
*.sha256

# MLflow / DVC
mlruns/
.dvc/

# pytest / coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# mypy / type checkers
.mypy_cache/
.dmypy.json
dmypy.json

# Profiling
*.prof


